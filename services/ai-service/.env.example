PORT=3001
NODE_ENV=development
LLM_PROVIDER=mock

# Set your Groq API Key to enable live llama-3.3-70b-versatile inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Centralized Shared MongoDB Atlas Database URI for Voyana team
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/voyana?retryWrites=true&w=majority
# Local fallback format: mongodb://localhost:27017/voyana
MONGODB_URI=mongodb://localhost:27017/voyana
MONGODB_DB_NAME=voyana

# Shared JWT Secret for authentication & session verification
JWT_SECRET=replace-with-a-long-random-private-secret

# Enable once to load demo records, then disable again.
SEED_ON_START=false
# Google Identity Services (public Web application client ID; no client secret needed)
GOOGLE_CLIENT_ID=
# Include every exact frontend origin used for Google login.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Project demo: OTP is displayed on screen. No SMS, PAN, bank account or gateway account needed.
PAYMENT_PROVIDER=demo
# Optional real Razorpay Test Mode adapter; unused while PAYMENT_PROVIDER=demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Group invitation email sender
RESEND_API_KEY=
INVITATION_FROM=
PUBLIC_APP_URL=http://localhost:5173
# Photo-aware memory model
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Photon-compatible place search / reverse lookup (public demo for moderate use; cached and limited)
GEOCODER_URL=https://photon.komoot.io
