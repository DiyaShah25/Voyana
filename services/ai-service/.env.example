PORT=3001
NODE_ENV=development
LLM_PROVIDER=mock

# Set your Groq API Key to enable live llama-3.3-70b-versatile inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Centralized Shared MongoDB Atlas Database URI for Voyana team
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/voyana?retryWrites=true&w=majority
# Local fallback format: mongodb://localhost:27017/voyana
MONGODB_URI=mongodb://localhost:27017/voyana
MONGODB_DB_NAME=voyana

# Shared JWT Secret for authentication & session verification
JWT_SECRET=voyana-team-shared-secret-key-2026
